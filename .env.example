# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=sig
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=signatures

# Host ports
APP_PORT=8080
ADMINER_PORT=8081

# Public URL of the app. Icons in generated signatures are loaded from here
# by recipients' mail clients, so on production this MUST be a publicly
# reachable HTTPS URL (or a CDN where you copied public/icons).
PUBLIC_BASE_URL=http://localhost:8080
